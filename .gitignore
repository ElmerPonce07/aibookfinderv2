# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Firebase private config (important)
.env.local

# Node modules (already covered, but make sure it's here)
node_modules/

# Next.js build output
.next/

# Static build output (if you ever use `next export`)
out/

# Vercel deployment config (if using Vercel)
.vercel/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# macOS system file
.DS_Store

# Log files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

